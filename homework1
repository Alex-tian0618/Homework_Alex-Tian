public class CustomerRecord {
public static void main(String[] args) {
String customer = "Michael Jackson,mjackson@vcol.org,4500";

    int firstComma = customer.indexOf(",");
    int secondComma = customer.indexOf(",", firstComma + 1);
    String name = customer.substring(0, firstComma);
    String email = customer.substring(firstComma + 1, secondComma);
    int atIndex = email.indexOf("@");
    String domain = email.substring(atIndex + 1);
    String salary = customer.substring(secondComma + 1);
    String upperName = name.toUpperCase();
    System.out.println("Name: " + name);
    System.out.println("Email: " + email);
    System.out.println("Domain: " + domain);
    System.out.println("Salary: " + salary);
    System.out.println("Upper case name: " + upperName);
}

}

Expected output:

Name: Michael Jackson
Email: mjackson@vcol.org
Domain: vcol.org
Salary: 4500
Upper case name: MICHAEL JACKSON

